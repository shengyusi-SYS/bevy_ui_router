--- /dev/null
+++ b/bevy_input_focus/src/focus_preparation.rs
@@ -0,0 +1,236 @@
+//! A controlled publisher's allocation-free focus completion tail.
+
+use alloc::vec::Vec;
+use bevy_ecs::change_detection::Mut;
+use core::mem;
+
+use crate::{FocusOperation, InputFocus};
+
+/// Why a deferred focus completion could not be prepared or bound.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum FocusPreparationError {
+    /// The supplied operation is no longer the exact latest request.
+    LatestOperationChanged,
+    /// The operation is already effective or is not a deferred set request.
+    NotDeferred,
+    /// The focus instance or its complete event/source state changed after preparation.
+    FocusChanged,
+    /// The complete snapshot or accepted-event FIFO could not be allocated.
+    Capacity,
+}
+
+/// A prepared completion of one exact previously rejected focus operation.
+///
+/// This type grants no application lifecycle authority. Before preparation the
+/// controlled publisher must prove its original owner and the target's future
+/// eligibility. Preparation freezes the complete focus state and allocates both
+/// the snapshot and future FIFO. It never queries the world or calls a predicate
+/// or source observer.
+#[derive(Debug)]
+pub struct PreparedFocusChange {
+    expected: InputFocus,
+    next: Option<InputFocus>,
+}
+
+impl PreparedFocusChange {
+    /// Prepares revocation only when the effective focus is one of `targets`.
+    ///
+    /// Revocation appends the ordinary clear transition without superseding the
+    /// latest application request. An unrelated or empty focus is a check-only
+    /// no-op, including its buffered events and latest deferred source.
+    pub fn prepare_revoke_if(
+        focus: &InputFocus,
+        targets: &[bevy_ecs::entity::Entity],
+    ) -> Result<Self, FocusPreparationError> {
+        let expected = snapshot_with_capacity(focus, 0)?;
+        let next = if focus
+            .current_focus
+            .is_some_and(|target| targets.contains(&target))
+        {
+            let mut next = snapshot_with_capacity(focus, 1)?;
+            next.revoke();
+            Some(next)
+        } else {
+            None
+        };
+        Ok(Self { expected, next })
+    }
+
+    /// Prepares fulfilment of the exact latest deferred set operation.
+    ///
+    /// Its identity, diagnostic sequence, frozen source, and original cause are
+    /// preserved. Failure leaves `focus` and the publisher's owner untouched.
+    pub fn prepare_fulfil_deferred(
+        focus: &InputFocus,
+        operation: &FocusOperation,
+    ) -> Result<Self, FocusPreparationError> {
+        let prepared = Self {
+            expected: snapshot_with_capacity(focus, 0)?,
+            next: None,
+        };
+        prepared
+            .with_deferred(operation)
+            .map_err(|(_, error)| error)
+    }
+
+    /// Adds fulfilment of the exact latest deferred request after any revocation.
+    ///
+    /// The original request identity, source, sequence, and cause are retained.
+    /// Failure returns this prepared change intact, so an already prepared
+    /// revocation and the caller's original lifecycle owner remain available.
+    pub fn with_deferred(
+        mut self,
+        operation: &FocusOperation,
+    ) -> Result<Self, (Self, FocusPreparationError)> {
+        if let Err(error) = deferred_target(&self.expected, operation) {
+            return Err((self, error));
+        }
+        let result = if let Some(next) = self.next.as_mut() {
+            append_deferred(next, operation)
+        } else {
+            match snapshot_with_capacity(&self.expected, 1) {
+                Ok(mut next) => match append_deferred(&mut next, operation) {
+                    Ok(()) => {
+                        self.next = Some(next);
+                        Ok(())
+                    }
+                    Err(error) => Err(error),
+                },
+                Err(error) => Err(error),
+            }
+        };
+        match result {
+            Ok(()) => Ok(self),
+            Err(error) => Err((self, error)),
+        }
+    }
+
+    /// Binds the exact unchanged focus receiver before a publication tail.
+    ///
+    /// A mismatch returns the original prepared change so the caller retains its
+    /// owner and may classify or retry outside the tail. The successful borrow
+    /// prevents subsequent focus requests until the change is applied or dropped.
+    pub fn bind<'a>(
+        self,
+        focus: &'a mut InputFocus,
+    ) -> Result<BoundFocusChange<'a>, (Self, FocusPreparationError)> {
+        if *focus != self.expected {
+            return Err((self, FocusPreparationError::FocusChanged));
+        }
+        let Self { expected, next } = self;
+        // Release preparation-only storage before entering the publication tail.
+        drop(expected);
+        Ok(BoundFocusChange { focus, next })
+    }
+
+    /// Binds the exact receiver while preserving ECS change detection.
+    ///
+    /// Binding only reads the receiver. A validation-only no-op keeps its
+    /// change tick untouched; an actual replacement is marked changed by the
+    /// tracked mutable borrow when [`BoundTrackedFocusChange::apply`] runs.
+    pub fn bind_mut<'a>(
+        self,
+        focus: Mut<'a, InputFocus>,
+    ) -> Result<BoundTrackedFocusChange<'a>, (Self, FocusPreparationError)> {
+        if *focus != self.expected {
+            return Err((self, FocusPreparationError::FocusChanged));
+        }
+        let Self { expected, next } = self;
+        drop(expected);
+        Ok(BoundTrackedFocusChange { focus, next })
+    }
+}
+
+/// A linear, fully prepared change borrowing its exact focus receiver.
+#[derive(Debug)]
+pub struct BoundFocusChange<'a> {
+    focus: &'a mut InputFocus,
+    next: Option<InputFocus>,
+}
+
+impl BoundFocusChange<'_> {
+    /// Swaps only preallocated state into the receiver.
+    ///
+    /// Returns the old focus state for the caller to retire after publication,
+    /// or `None` for a check-only no-op that leaves the receiver untouched.
+    /// No opaque source data is dropped here, and no world queries, callbacks,
+    /// event triggers, allocations, or structural writes occur in this tail.
+    pub fn apply(self) -> Option<InputFocus> {
+        self.next.map(|next| mem::replace(self.focus, next))
+    }
+}
+
+/// A fully prepared change retaining the receiver's ECS change tracking.
+#[derive(Debug)]
+pub struct BoundTrackedFocusChange<'a> {
+    focus: Mut<'a, InputFocus>,
+    next: Option<InputFocus>,
+}
+
+impl BoundTrackedFocusChange<'_> {
+    /// Applies a prepared replacement only when the focus state must change.
+    ///
+    /// A no-op neither writes the receiver nor marks it changed. The returned
+    /// old state must be retired after publication, as for [`BoundFocusChange::apply`].
+    pub fn apply(self) -> Option<InputFocus> {
+        let Self { mut focus, next } = self;
+        next.map(|next| mem::replace(&mut *focus, next))
+    }
+}
+
+fn deferred_target(
+    focus: &InputFocus,
+    operation: &FocusOperation,
+) -> Result<(bevy_ecs::entity::Entity, crate::FocusCause), FocusPreparationError> {
+    if focus.latest_operation.as_ref() != Some(operation) {
+        return Err(FocusPreparationError::LatestOperationChanged);
+    }
+    let (Some(target), Some(cause)) = (operation.target, operation.cause) else {
+        return Err(FocusPreparationError::NotDeferred);
+    };
+    if operation.accepted {
+        return Err(FocusPreparationError::NotDeferred);
+    }
+    Ok((target, cause))
+}
+
+fn append_deferred(
+    next: &mut InputFocus,
+    operation: &FocusOperation,
+) -> Result<(), FocusPreparationError> {
+    let (target, cause) = deferred_target(next, operation)?;
+    next.recorded_changes
+        .try_reserve_exact(1)
+        .map_err(|_| FocusPreparationError::Capacity)?;
+    next.current_focus = Some(target);
+    next.recorded_changes.push(Some((target, cause)));
+    next.latest_operation
+        .as_mut()
+        .expect("validated latest operation")
+        .accepted = true;
+    Ok(())
+}
+
+fn snapshot_with_capacity(
+    focus: &InputFocus,
+    additional: usize,
+) -> Result<InputFocus, FocusPreparationError> {
+    let capacity = focus
+        .recorded_changes
+        .len()
+        .checked_add(additional)
+        .ok_or(FocusPreparationError::Capacity)?;
+    let mut recorded_changes = Vec::new();
+    recorded_changes
+        .try_reserve_exact(capacity)
+        .map_err(|_| FocusPreparationError::Capacity)?;
+    recorded_changes.extend_from_slice(&focus.recorded_changes);
+    Ok(InputFocus {
+        current_focus: focus.current_focus,
+        recorded_changes,
+        original_focus: focus.original_focus,
+        operation_sequence: focus.operation_sequence,
+        instance: focus.instance.clone(),
+        latest_operation: focus.latest_operation.clone(),
+    })
+}
