diff --git a/bevy_input_focus/src/focus_access.rs b/bevy_input_focus/src/focus_access.rs
new file mode 100644
--- /dev/null
+++ b/bevy_input_focus/src/focus_access.rs
@@ -0,0 +1,105 @@
+//! World-aware synchronous focus admission for the interface feasibility probe.
+
+use bevy_ecs::{prelude::*, system::SystemParam, world::DeferredWorld};
+
+use crate::{
+    FocusCause, FocusObservation, FocusOperation, InputFocus,
+    qualification::input_target_is_eligible,
+};
+
+/// Freezes ordinary operation-source data while the real world is still readable.
+///
+/// The callback has no mutable world access and does not grant publication
+/// authority. A controlled publisher must retain its own original owner.
+#[derive(Resource, Clone, Copy)]
+pub struct FocusOperationObserver {
+    observer: fn(&World, &FocusOperation) -> Option<FocusObservation>,
+}
+
+impl FocusOperationObserver {
+    /// Creates the optional synchronous source observer.
+    pub const fn new(observer: fn(&World, &FocusOperation) -> Option<FocusObservation>) -> Self {
+        Self { observer }
+    }
+}
+
+/// Prepares one request before borrowing the focus resource for mutation.
+///
+/// Native entry points must call this helper rather than qualifying a target and
+/// later reconstructing its source from the mutated world.
+pub(crate) fn prepare_request(
+    world: &World,
+    target: Option<Entity>,
+    cause: Option<FocusCause>,
+) -> Option<FocusOperation> {
+    let accepted = target.is_none_or(|target| input_target_is_eligible(world, target));
+    let mut operation = world
+        .get_resource::<InputFocus>()?
+        .prepare_operation(target, cause, accepted);
+    if let Some(observer) = world.get_resource::<FocusOperationObserver>() {
+        operation.observation = (observer.observer)(world, &operation);
+    }
+    Some(operation)
+}
+
+/// World-aware focus access. The read-only world parameter deliberately exposes
+/// the scheduler's broad read borrow; qualification is not a cached boolean.
+#[derive(SystemParam)]
+pub struct FocusWriter<'w, 's> {
+    access: ParamSet<'w, 's, (&'w World, ResMut<'w, InputFocus>)>,
+}
+
+impl FocusWriter<'_, '_> {
+    /// Reads the installed target policy without issuing or superseding a request.
+    ///
+    /// Native candidate algorithms use the same live world facts as the later
+    /// synchronous set entry. This method does not observe an operation source.
+    pub fn target_is_eligible(&mut self, target: Entity) -> bool {
+        input_target_is_eligible(self.access.p0(), target)
+    }
+
+    /// Returns the currently effective focus.
+    pub fn get(&mut self) -> Option<Entity> {
+        self.access.p0().resource::<InputFocus>().get()
+    }
+
+    /// Qualifies and observes a set request synchronously before making it effective.
+    pub fn set(&mut self, entity: Entity, cause: FocusCause) {
+        let operation = prepare_request(self.access.p0(), Some(entity), Some(cause))
+            .expect("FocusWriter owns an existing InputFocus resource");
+        self.access.p1().apply_request(operation);
+    }
+
+    /// Clears focus and supersedes every preceding request, including empty clears.
+    pub fn clear(&mut self) {
+        let operation = prepare_request(self.access.p0(), None, None)
+            .expect("FocusWriter owns an existing InputFocus resource");
+        self.access.p1().apply_request(operation);
+    }
+
+    /// Returns an immutable observation of the latest request.
+    pub fn latest_operation(&mut self) -> Option<FocusOperation> {
+        self.access.p0().resource::<InputFocus>().latest_operation()
+    }
+}
+
+/// Requests focus from an exclusive or deferred world, using the same admission
+/// and source observation as [`FocusWriter`].
+pub fn set_focus(world: &mut DeferredWorld<'_>, entity: Entity, cause: FocusCause) {
+    let Some(operation) = prepare_request(world, Some(entity), Some(cause)) else {
+        return;
+    };
+    if let Some(mut focus) = world.get_resource_mut::<InputFocus>() {
+        focus.apply_request(operation);
+    }
+}
+
+/// Clears focus from an exclusive or deferred world through the operation entry.
+pub fn clear_focus(world: &mut DeferredWorld<'_>) {
+    let Some(operation) = prepare_request(world, None, None) else {
+        return;
+    };
+    if let Some(mut focus) = world.get_resource_mut::<InputFocus>() {
+        focus.apply_request(operation);
+    }
+}
