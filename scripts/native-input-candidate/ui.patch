+//! Optional application policy for native input target eligibility.
+
+use bevy_ecs::{entity::Entity, resource::Resource, world::World};
+
+/// A shared eligibility policy for native focus selection and input dispatch.
+///
+/// The policy qualifies individual targets. Rejecting a container does not reject
+/// its descendants or change event bubbling through that container.
+///
+/// Without this resource, native input retains its original behavior. Applications
+/// can combine their own policies inside one callback; this resource does not
+/// provide a second focus state or a replacement navigation algorithm.
+#[derive(Resource, Clone, Copy)]
+pub struct InputTargetEligibility {
+    predicate: fn(&World, Entity) -> bool,
+}
+
+impl InputTargetEligibility {
+    /// Creates an eligibility policy from a read-only world predicate.
+    pub const fn new(predicate: fn(&World, Entity) -> bool) -> Self {
+        Self { predicate }
+    }
+
+    /// Returns whether an entity may be selected as a native input target.
+    pub fn accepts(&self, world: &World, entity: Entity) -> bool {
+        (self.predicate)(world, entity)
+    }
+}
+
+pub(crate) fn input_target_is_eligible(world: &World, entity: Entity) -> bool {
+    world
+        .get_resource::<InputTargetEligibility>()
+        .is_none_or(|eligibility| eligibility.accepts(world, entity))
+}
