+fn frame_accepts_target(
+    reader: &impl ScopeRead,
+    entry: &RouterEntry,
+    frame: &RealizedFrame,
+    target: Entity,
+    boundary: Entity,
+) -> bool {
+    let Some(claim) = frame.claims().find(|claim| claim.entity() == boundary) else {
+        return false;
+    };
+    if claim.lifecycle() != EntityLifecycle::Active || !reader.claim_is_current(claim) {
+        return false;
+    }
+    let Some(mut proof) = FrameScopeFacts::from_entry(entry, frame) else {
+        return false;
+    };
+    if target == boundary {
+        if proof.include_registered_content(frame, target).is_none() {
+            return false;
+        }
+    } else if frame.native_root() != Some(boundary) {
+        return false;
+    }
+    proof.is_current(reader)
+}
