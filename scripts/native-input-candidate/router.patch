+#[cfg(feature = "bsn")]
+pub(crate) fn freeze_borrowed_scopes(world: &mut World, entries: &[RouterEntry]) {
+    let frames = entries
+        .iter()
+        .flat_map(FrozenActiveFrame::from_entry)
+        .collect();
+    // This private synchronous read cache is not a semantic resource mutation.
+    // Keep its carrier and change ticks stable across no-action driver passes.
+    use bevy_ecs::change_detection::DetectChangesMut;
+    world
+        .resource_mut::<BorrowedActiveScopes>()
+        .bypass_change_detection()
+        .0 = frames;
+}
+
+#[cfg(feature = "bsn")]
+pub(crate) fn refresh_borrowed_entry(world: &mut World, entry: &RouterEntry) {
+    let replacement = FrozenActiveFrame::from_entry(entry);
+    use bevy_ecs::change_detection::DetectChangesMut;
+    let mut scopes = world.resource_mut::<BorrowedActiveScopes>();
+    let scopes = scopes.bypass_change_detection();
+    scopes.0.retain(|frame| frame.router != entry.handle);
+    scopes.0.extend(replacement);
+}
+
+#[cfg(feature = "bsn")]
+pub(crate) fn clear_borrowed_scopes(world: &mut World) {
+    use bevy_ecs::change_detection::DetectChangesMut;
+    world
+        .resource_mut::<BorrowedActiveScopes>()
+        .bypass_change_detection()
+        .0
+        .clear();
+}
+
+#[cfg(feature = "bsn")]
+pub(crate) fn target_is_active(world: &World, target: Entity) -> bool {
+    let reader = WorldScopeRead(world);
+    let Some(boundary) = nearest_boundary(&reader, target) else {
+        return false;
+    };
+    if let Some(navigation) = world.get_resource::<RouterNavigation>() {
+        navigation.entries.iter().any(|entry| {
+            entry.active.as_ref().is_some_and(|active| {
+                active
+                    .frames()
+                    .iter()
+                    .any(|frame| frame_accepts_target(&reader, entry, frame, target, boundary))
+            })
+        })
+    } else {
+        world
+            .get_resource::<BorrowedActiveScopes>()
+            .is_some_and(|scopes| {
+                scopes
+                    .0
+                    .iter()
+                    .any(|frame| frame.resolves(&reader, target, boundary))
+            })
+    }
+}
