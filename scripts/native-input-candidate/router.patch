+/// Stops at the nearest registered or quarantined boundary, using live edges.
+fn nearest_boundary(reader: &impl ScopeRead, target: Entity) -> Option<Entity> {
+    let mut current = target;
+    let mut seen = HashSet::new();
+    while seen.insert(current) {
+        if reader.is_quarantined(current) || reader.facts(current).is_none() {
+            return None;
+        }
+        if reader.registry().record(current).is_some() {
+            return Some(current);
+        }
+        let parent = reader.facts(current)?.parent.map(ChildOf::parent)?;
+        if !reader.edge_is_current(current, parent) {
+            return None;
+        }
+        current = parent;
+    }
+    None
+}
