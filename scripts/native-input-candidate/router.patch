@@ -0,0 +1,363 @@
+//! A complete public Router journey through the stock input, Tab and dispatch
+//! plugins. Route lifecycle facts come only from ordinary navigation.
+
+use bevy_app::App;
+use bevy_asset::AssetPlugin;
+use bevy_ecs::prelude::*;
+use bevy_input_focus::{
+    FocusCause, FocusGained, FocusLost, FocusedInput, InputDispatchPlugin, InputFocus,
+    InputFocusPlugin, set_focus,
+    tab_navigation::{TabGroup, TabIndex, TabNavigationPlugin},
+};
+use bevy_internal::{
+    DefaultPlugins,
+    camera::Camera2d,
+    input::{
+        ButtonState, InputPlugin,
+        keyboard::{Key, KeyCode, KeyboardInput},
+    },
+    window::{PrimaryWindow, Window},
+};
+use bevy_scene::{ScenePlugin, bsn};
+use bevy_ui::{ComputedNode, Node, Val};
+use bevy_ui_router::prelude::*;
+
+#[derive(Component, Clone, Default)]
+struct Page(&'static str);
+
+#[derive(Debug, PartialEq)]
+enum FocusEvent {
+    Gained(Entity, FocusCause),
+    Lost(Entity),
+}
+
+#[derive(Resource, Default)]
+struct Deliveries {
+    keyboard: Vec<Entity>,
+    focus: Vec<FocusEvent>,
+}
+
+fn keyboard(window: Entity, key_code: KeyCode, state: ButtonState) -> KeyboardInput {
+    KeyboardInput {
+        key_code,
+        logical_key: if key_code == KeyCode::Tab {
+            Key::Tab
+        } else {
+            Key::Character("a".into())
+        },
+        state,
+        text: None,
+        repeat: false,
+        window,
+    }
+}
+
+fn tab(app: &mut App, window: Entity) {
+    app.world_mut()
+        .write_message(keyboard(window, KeyCode::Tab, ButtonState::Released));
+    app.world_mut()
+        .write_message(keyboard(window, KeyCode::Tab, ButtonState::Pressed));
+    app.update();
+}
+
+fn assert_keyboard_delivery(app: &mut App, window: Entity, target: Entity) {
+    app.world_mut()
+        .resource_mut::<Deliveries>()
+        .keyboard
+        .clear();
+    app.world_mut()
+        .write_message(keyboard(window, KeyCode::KeyA, ButtonState::Released));
+    app.world_mut()
+        .write_message(keyboard(window, KeyCode::KeyA, ButtonState::Pressed));
+    app.update();
+    assert_eq!(app.world().resource::<Deliveries>().keyboard, vec![target]);
+}
+
+fn focus(app: &mut App, target: Entity, cause: FocusCause) {
+    set_focus(&mut app.world_mut().into(), target, cause);
+}
+
+fn current(app: &App) -> Option<Entity> {
+    app.world().resource::<InputFocus>().get()
+}
+
+fn settle(app: &mut App, router: RouterHandle, request: NavigationRequestId) {
+    for _ in 0..32 {
+        app.update();
+        match app
+            .world()
+            .resource::<RouterSnapshots>()
+            .request(router, request)
+        {
+            RequestLookup::Found(request) if request.status() == &RequestStatus::Succeeded => {
+                // Include normal layout after publication before native navigation.
+                app.update();
+                return;
+            }
+            RequestLookup::Found(request)
+                if matches!(request.status(), RequestStatus::Failed(_)) =>
+            {
+                panic!("native navigation failed: {:?}", request.status());
+            }
+            _ => {}
+        }
+    }
+    panic!("native navigation did not settle");
+}
+
+fn page(app: &mut App, name: &'static str) -> Entity {
+    app.world_mut()
+        .query::<(Entity, &Page)>()
+        .iter(app.world())
+        .find_map(|(entity, page)| (page.0 == name).then_some(entity))
+        .unwrap()
+}
+
+#[test]
+fn native_tab_and_dispatch_follow_retention_without_blocking_application_controls() {
+    let mut app = App::new();
+    // The selected default plugins run the real headless UI layout and input
+    // pipeline; no Winit loop, renderer or Router intermediate schedule is used.
+    app.add_plugins(DefaultPlugins);
+    if !app.is_plugin_added::<AssetPlugin>() {
+        app.add_plugins(AssetPlugin::default());
+    }
+    if !app.is_plugin_added::<ScenePlugin>() {
+        app.add_plugins(ScenePlugin);
+    }
+    if !app.is_plugin_added::<InputPlugin>() {
+        app.add_plugins(InputPlugin);
+    }
+    if !app.is_plugin_added::<InputFocusPlugin>() {
+        app.add_plugins(InputFocusPlugin);
+    }
+    if !app.is_plugin_added::<InputDispatchPlugin>() {
+        app.add_plugins(InputDispatchPlugin);
+    }
+    if !app.is_plugin_added::<TabNavigationPlugin>() {
+        app.add_plugins(TabNavigationPlugin);
+    }
+    app.init_resource::<Deliveries>();
+    app.add_observer(
+        |mut event: On<FocusedInput<KeyboardInput>>, mut deliveries: ResMut<Deliveries>| {
+            if event.input.key_code == KeyCode::KeyA && event.input.state == ButtonState::Pressed {
+                deliveries.keyboard.push(event.focused_entity);
+                event.propagate(false);
+            }
+        },
+    );
+    app.add_observer(
+        |mut event: On<FocusGained>, mut deliveries: ResMut<Deliveries>| {
+            deliveries
+                .focus
+                .push(FocusEvent::Gained(event.entity, event.cause));
+            event.propagate(false);
+        },
+    );
+    app.add_observer(
+        |mut event: On<FocusLost>, mut deliveries: ResMut<Deliveries>| {
+            deliveries.focus.push(FocusEvent::Lost(event.entity));
+            event.propagate(false);
+        },
+    );
+    let window = app
+        .world_mut()
+        .query_filtered::<Entity, With<PrimaryWindow>>()
+        .single(app.world())
+        .unwrap();
+    app.world_mut()
+        .get_mut::<Window>(window)
+        .unwrap()
+        .resolution
+        .set(320.0, 180.0);
+    app.world_mut().spawn(Camera2d);
+
+    let layout = app
+        .register_bsn_view(ViewDriverKey::new("native-tab-layout").unwrap(), |_| {
+            Ok(bsn! {
+                Node { width: Val::Percent(100.0), height: Val::Percent(100.0) }
+                DefaultOutlet
+            })
+        })
+        .unwrap();
+    let layout_key = RouteViewKey::new("layout").unwrap();
+    let mut views = RouteViewRegistry::new();
+    views
+        .insert(layout_key.clone(), RouteViewDescriptor::new(layout))
+        .unwrap();
+    for name in ["a", "b"] {
+        let driver = app
+            .register_bsn_view(ViewDriverKey::new(name).unwrap(), move |_| {
+                Ok(bsn! {
+                    Node { width: Val::Px(80.0), height: Val::Px(48.0) }
+                    TabIndex(10)
+                    Page(name)
+                })
+            })
+            .unwrap();
+        views
+            .insert(
+                RouteViewKey::new(name).unwrap(),
+                RouteViewDescriptor::new(driver),
+            )
+            .unwrap();
+    }
+    let mut routes = RouteTree::builder()
+        .root_with_options(
+            RoutePattern::pathless(),
+            RouteNodeOptions::new().with_view(layout_key.clone()),
+        )
+        .unwrap();
+    for name in ["a", "b"] {
+        routes
+            .route_with_options(
+                routes.root_id().unwrap(),
+                RoutePattern::path(name).unwrap(),
+                RouteNodeOptions::new()
+                    .with_view(RouteViewKey::new(name).unwrap())
+                    .with_keep_alive(true),
+            )
+            .unwrap();
+    }
+    let router = app
+        .add_ui_router(
+            RouterConfig::new(routes.build().unwrap(), views, layout_key)
+                .with_keep_alive_capacity(2),
+        )
+        .unwrap();
+    let group = app
+        .world_mut()
+        .spawn((
+            Node {
+                width: Val::Percent(100.0),
+                height: Val::Percent(100.0),
+                ..Node::default()
+            },
+            TabGroup::new(0),
+        ))
+        .id();
+    app.world_mut().spawn((
+        Node {
+            width: Val::Px(180.0),
+            height: Val::Px(120.0),
+            ..Node::default()
+        },
+        RouterHostRegistration::new(router),
+        ChildOf(group),
+    ));
+    let application = app
+        .world_mut()
+        .spawn((
+            Node {
+                width: Val::Px(40.0),
+                height: Val::Px(32.0),
+                ..Node::default()
+            },
+            TabIndex(30),
+            ChildOf(group),
+        ))
+        .id();
+    app.update();
+    let request = app
+        .world_mut()
+        .resource_mut::<RouterNavigation>()
+        .push(router, RouteLocation::new("/a"))
+        .unwrap();
+    settle(&mut app, router, request);
+    let a = page(&mut app, "a");
+    assert!(!app.world().get::<ComputedNode>(a).unwrap().is_empty());
+    assert!(app.world().resource::<RouterInputGate>().allows_keyboard(a));
+    tab(&mut app, window);
+    assert_eq!(current(&app), Some(a));
+    assert_keyboard_delivery(&mut app, window, a);
+
+    let request = app
+        .world_mut()
+        .resource_mut::<RouterNavigation>()
+        .push(router, RouteLocation::new("/b"))
+        .unwrap();
+    settle(&mut app, router, request);
+    let b = page(&mut app, "b");
+    // A remains the original real Entity and still declares a native TabIndex;
+    // navigation qualification must exclude it without destroying the page.
+    assert!(app.world().get_entity(a).is_ok());
+    assert_eq!(app.world().get::<TabIndex>(a).unwrap().0, 10);
+    assert!(!app.world().resource::<RouterInputGate>().allows_keyboard(a));
+    assert_ne!(current(&app), Some(a));
+    assert!(!app.world().get::<ComputedNode>(b).unwrap().is_empty());
+    tab(&mut app, window);
+    assert_eq!(current(&app), Some(b));
+    assert_keyboard_delivery(&mut app, window, b);
+
+    // An application focus request cannot make a retained page effective, even
+    // synchronously before the next Router refresh or native dispatch.
+    focus(&mut app, a, FocusCause::Pressed);
+    assert_eq!(current(&app), Some(b));
+    assert_keyboard_delivery(&mut app, window, b);
+
+    // New legitimate controls are authored under the active page after its
+    // publication. Native Tab sees the current hierarchy, without a cached list.
+    let dynamic = app
+        .world_mut()
+        .spawn((
+            Node {
+                width: Val::Px(20.0),
+                height: Val::Px(12.0),
+                ..Node::default()
+            },
+            TabIndex(20),
+            ChildOf(b),
+        ))
+        .id();
+    app.update();
+    assert!(!app.world().get::<ComputedNode>(dynamic).unwrap().is_empty());
+    tab(&mut app, window);
+    assert_eq!(current(&app), Some(dynamic));
+    assert_keyboard_delivery(&mut app, window, dynamic);
+    tab(&mut app, window);
+    assert_eq!(current(&app), Some(application));
+    assert_keyboard_delivery(&mut app, window, application);
+    tab(&mut app, window);
+    assert_eq!(
+        current(&app),
+        Some(b),
+        "retained A must also be skipped on wrap"
+    );
+
+    // The official event processor preserves application operation order and
+    // causes while moving between Router content and a public application UI.
+    app.world_mut().resource_mut::<Deliveries>().focus.clear();
+    focus(&mut app, dynamic, FocusCause::Navigated);
+    focus(&mut app, application, FocusCause::Pressed);
+    app.update();
+    assert_eq!(
+        app.world().resource::<Deliveries>().focus,
+        vec![
+            FocusEvent::Lost(b),
+            FocusEvent::Gained(dynamic, FocusCause::Navigated),
+            FocusEvent::Lost(dynamic),
+            FocusEvent::Gained(application, FocusCause::Pressed),
+        ]
+    );
+    assert_keyboard_delivery(&mut app, window, application);
+
+    // Returning reactivates the original A, with the stock plugins still in
+    // charge. B and its dynamic child now leave the input scope together.
+    let request = app
+        .world_mut()
+        .resource_mut::<RouterNavigation>()
+        .back(router)
+        .unwrap();
+    settle(&mut app, router, request);
+    assert_eq!(page(&mut app, "a"), a);
+    assert!(!app.world().resource::<RouterInputGate>().allows_keyboard(b));
+    assert!(
+        !app.world()
+            .resource::<RouterInputGate>()
+            .allows_keyboard(dynamic)
+    );
+    assert_eq!(current(&app), Some(application));
+    tab(&mut app, window);
+    assert_eq!(current(&app), Some(a));
+    assert_keyboard_delivery(&mut app, window, a);
+}
