 #[test]
+fn application_eligibility_also_rejects_pending_autofocus_at_publication() {
+    let mut fixture = fixture(vec![], vec![], false, true);
+    prepare_prefix(&mut fixture, false, true);
+    let previous_focus = fixture.app.world().resource::<InputFocus>().get();
+    fixture
+        .app
+        .world_mut()
+        .resource_mut::<ApplicationFocusPolicy>()
+        .reject_native_targets = true;
+    let request = push(&mut fixture, true);
+    fixture.app.update();
+    let target = fixture.app.world().resource::<Attempts>().targets[0];
+    assert_eq!(
+        fixture
+            .app
+            .world()
+            .resource::<Attempts>()
+            .autofocus_saw_focus,
+        vec![previous_focus],
+        "the real AutoFocus hook must preserve eligible application focus synchronously"
+    );
+    assert_eq!(
+        fixture.app.world().resource::<InputFocus>().get(),
+        previous_focus
+    );
+    let denied = fixture
+        .app
+        .world()
+        .resource::<InputFocus>()
+        .latest_operation()
+        .unwrap();
+    assert_eq!(denied.target, Some(target));
+    assert_eq!(denied.cause, Some(FocusCause::Navigated));
+    assert!(!denied.accepted);
+    assert_no_target_events(&fixture, target);
+
+    settle(&mut fixture, request, false);
+    assert!(
+        fixture
+            .app
+            .world()
+            .resource::<RouterInputGate>()
+            .allows_keyboard(target),
+        "navigation publishes an active page; the independent application policy only denies its focus"
+    );
+    assert_eq!(
+        fixture.app.world().resource::<InputFocus>().get(),
+        previous_focus
+    );
+    assert_no_target_events(&fixture, target);
+    let final_operation = fixture
+        .app
+        .world()
+        .resource::<InputFocus>()
+        .latest_operation()
+        .unwrap();
+    assert_eq!(final_operation.identity(), denied.identity());
+    assert!(
+        !final_operation.accepted,
+        "publication must recheck application eligibility"
+    );
+}
