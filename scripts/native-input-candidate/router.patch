+impl ActiveRouteScope<'_, '_> {
+    pub(crate) fn resolve(&self, target: Entity) -> Option<(&RouterEntry, &RealizedFrame)> {
+        let boundary = nearest_boundary(self, target)?;
+        for entry in &self.navigation.entries {
+            for frame in entry
+                .active
+                .as_ref()
+                .into_iter()
+                .flat_map(|active| active.frames())
+            {
+                if frame.claims().any(|claim| claim.entity() == boundary) {
+                    return frame_accepts_target(self, entry, frame, target, boundary)
+                        .then_some((entry, frame));
+                }
+            }
+        }
+        None
+    }
+}
