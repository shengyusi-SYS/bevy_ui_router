diff --git a/crates/bevy_ui_router_core/src/publication_allocation_diagnostic.rs b/crates/bevy_ui_router_core/src/publication_allocation_diagnostic.rs
new file mode 100644
--- /dev/null
+++ b/crates/bevy_ui_router_core/src/publication_allocation_diagnostic.rs
@@ -0,0 +1,106 @@
+//! Temporary diagnostic only: allocation counts during observation construction.
+//! Linking allocation-counter replaces the allocator even with the env unset.
+use std::{cell::Cell, sync::OnceLock};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Purpose {
+    Freeze,
+    Compare,
+}
+
+#[derive(Clone, Copy, Debug, Default)]
+pub struct Counts {
+    pub calls: u64,
+    pub allocations: u64,
+    pub bytes: u64,
+}
+
+#[derive(Clone, Copy, Default)]
+struct State {
+    active: bool,
+    measuring: bool,
+    counts: Counts,
+}
+
+thread_local! {
+    static STATE: Cell<State> = const { Cell::new(State {
+        active: false,
+        measuring: false,
+        counts: Counts { calls: 0, allocations: 0, bytes: 0 },
+    }) };
+}
+
+fn selected() -> Option<Purpose> {
+    static SELECTED: OnceLock<Option<Purpose>> = OnceLock::new();
+    *SELECTED.get_or_init(
+        || match std::env::var("ROUTER_BENCH_PUBLICATION_ALLOCATIONS") {
+            Err(std::env::VarError::NotPresent) => None,
+            Ok(value) if value == "freeze" => Some(Purpose::Freeze),
+            Ok(value) if value == "compare" => Some(Purpose::Compare),
+            other => panic!(
+                "ROUTER_BENCH_PUBLICATION_ALLOCATIONS must be unset, freeze or compare: {other:?}"
+            ),
+        },
+    )
+}
+
+pub fn scope_name() -> Option<&'static str> {
+    selected().map(|scope| match scope {
+        Purpose::Freeze => "owned_freeze",
+        Purpose::Compare => "immediate_compare",
+    })
+}
+
+// Called by the existing benchmark immediately before its measured navigation.
+// Warmup/setup/reset/idle/teardown do not enable this current-thread scope.
+pub fn begin_navigation() {
+    assert!(selected().is_some());
+    STATE.with(|state| {
+        assert!(!state.get().active);
+        state.set(State {
+            active: true,
+            ..State::default()
+        });
+    });
+}
+
+// Called after Fixture::navigate has captured elapsed and checked completion.
+pub fn finish_navigation() -> Counts {
+    STATE.with(|state| {
+        let completed = state.replace(State::default());
+        assert!(completed.active && !completed.measuring);
+        assert!(
+            completed.counts.calls > 0,
+            "no observation calls on this navigation thread"
+        );
+        completed.counts
+    })
+}
+
+pub(crate) fn observe<T>(purpose: Purpose, make_observation: impl FnOnce() -> T) -> T {
+    if selected() != Some(purpose) || !STATE.with(|state| state.get().active) {
+        return make_observation();
+    }
+    STATE.with(|state| {
+        let mut current = state.get();
+        assert!(
+            !current.measuring,
+            "publication allocation scopes must not nest"
+        );
+        current.measuring = true;
+        state.set(current);
+    });
+    let mut observation = None;
+    let allocation = allocation_counter::measure(|| {
+        observation = Some(make_observation());
+    });
+    STATE.with(|state| {
+        let mut current = state.get();
+        current.measuring = false;
+        current.counts.calls += 1;
+        current.counts.allocations += allocation.count_total;
+        current.counts.bytes += allocation.bytes_total;
+        state.set(current);
+    });
+    observation.expect("observation closure always returns")
+}
