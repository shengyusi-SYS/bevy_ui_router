+
+// Temporary, current-thread diagnostic. Never encloses a whole navigation in
+// allocation_counter::measure: each observation call measures its own scope.
+#[derive(Default)]
+struct PublicationAllocations {
+    totals: publication_alloc::Counts,
+    navigations: usize,
+}
+
+impl PublicationAllocations {
+    fn begin(&self, measured: bool) {
+        if measured && publication_alloc::scope_name().is_some() {
+            publication_alloc::begin_navigation();
+        }
+    }
+
+    fn finish(&mut self, measured: bool) {
+        if measured && publication_alloc::scope_name().is_some() {
+            let counts = publication_alloc::finish_navigation();
+            self.totals.calls += counts.calls;
+            self.totals.allocations += counts.allocations;
+            self.totals.bytes += counts.bytes;
+            self.navigations += 1;
+        }
+    }
+
+    fn report(&self, mode: &str, scenario: &str, content: usize, shape: ContentShape) {
+        if let Some(scope) = publication_alloc::scope_name() {
+            eprintln!(
+                "publication_allocation,{mode},{scenario},{content},{shape:?},{scope},{},{},{},{}",
+                self.navigations, self.totals.calls, self.totals.allocations, self.totals.bytes
+            );
+        }
+    }
+}

