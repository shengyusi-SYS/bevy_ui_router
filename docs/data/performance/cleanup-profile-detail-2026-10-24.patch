+//! Temporary, opt-in inclusive wall-time probes. Not a production API.
+//! Every instrumented call is synchronous and runs from exclusive lifecycle work
+//! on the thread that executes App::update. reset/take use that same thread.
+use std::{
+    cell::RefCell,
+    sync::OnceLock,
+    time::{Duration, Instant},
+};
+
+pub const SCOPE_NAMES: [&str; 8] = [
+    "targets_are_current",
+    "related_protected_is_current",
+    "current_focus_targets",
+    "settle_prepared_removal",
+    "prepare_input_gate_mutation",
+    "try_prepare_pointer_revocations",
+    "removed_receipt_index",
+    "protected_fields",
+];
+
+#[derive(Clone, Copy)]
+#[repr(usize)]
+pub(crate) enum Scope {
+    TargetsAreCurrent,
+    RelatedProtectedIsCurrent,
+    CurrentFocusTargets,
+    SettlePreparedRemoval,
+    PrepareInputGateMutation,
+    TryPreparePointerRevocations,
+    RemovedReceiptIndex,
+    ProtectedFields,
+}
+
+#[derive(Clone, Copy, Debug, Default)]
+pub struct Counter {
+    pub calls: u64,
+    pub elapsed: Duration,
+}
+
+thread_local! {
+    static COUNTERS: RefCell<[Counter; 8]> = const {
+        RefCell::new([Counter { calls: 0, elapsed: Duration::ZERO }; 8])
+    };
+}
+
+pub fn enabled() -> bool {
+    static ENABLED: OnceLock<bool> = OnceLock::new();
+    *ENABLED.get_or_init(|| std::env::var("ROUTER_BENCH_PROFILE_SCOPES").as_deref() == Ok("1"))
+}
+
+/// Clear only outside the measured App::update call, with no live scope guards.
+pub fn reset() {
+    COUNTERS.with(|counters| *counters.borrow_mut() = [Counter::default(); 8]);
+}
+
+/// Read and clear after App::update returns. Nested scope times are inclusive.
+pub fn take() -> [Counter; 8] {
+    COUNTERS.with(|counters| std::mem::take(&mut *counters.borrow_mut()))
+}
+
+pub(crate) struct ScopeTimer {
+    scope: Scope,
+    start: Option<Instant>,
+}
+
+pub(crate) fn enter(scope: Scope) -> ScopeTimer {
+    ScopeTimer {
+        scope,
+        start: enabled().then(Instant::now),
+    }
+}
+
+impl Drop for ScopeTimer {
+    fn drop(&mut self) {
+        if let Some(start) = self.start {
+            let elapsed = start.elapsed();
+            COUNTERS.with(|counters| {
+                let counter = &mut counters.borrow_mut()[self.scope as usize];
+                counter.calls += 1;
+                counter.elapsed += elapsed;
+            });
+        }
+    }
+}
