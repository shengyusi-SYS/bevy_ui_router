+// Temporary diagnostics only. All reporting happens after navigation's elapsed
+// sample is captured; per-update rows are buffered to avoid printing in timing.
+thread_local! {
+    static PROFILE_CONTEXT: std::cell::Cell<(&'static str, &'static str, usize)> =
+        const { std::cell::Cell::new(("baseline", "unclassified", 0)) };
+}
+
+fn profile_context(scenario: &'static str, phase: &'static str, iteration: usize) {
+    if temporary_profile::enabled() {
+        PROFILE_CONTEXT.with(|context| context.set((scenario, phase, iteration)));
+    }
+}
+
+struct ProfileUpdate {
+    update: usize,
+    elapsed: Duration,
+    scopes: [temporary_profile::Counter; 8],
+}
+
+struct NavigationProfile<'a> {
+    navigation: u64,
+    content: usize,
+    shape: ContentShape,
+    action: Action,
+    path: &'a str,
+    scenario: &'static str,
+    phase: &'static str,
+    iteration: usize,
+    rows: Vec<ProfileUpdate>,
+}
+
+impl<'a> NavigationProfile<'a> {
+    fn new(content: usize, shape: ContentShape, action: Action, path: &'a str) -> Option<Self> {
+        if !temporary_profile::enabled() {
+            return None;
+        }
+        static HEADER: std::sync::Once = std::sync::Once::new();
+        HEADER.call_once(|| {
+            eprintln!("# router_profile: inclusive wall times; nested scopes MUST NOT be summed; diagnostic binary only");
+            let mut header = String::from("record,nav_id,scenario,phase,iteration,content,shape,action,path,update,update_ns");
+            for name in temporary_profile::SCOPE_NAMES {
+                header.push_str(&format!(",{name}_calls,{name}_inclusive_ns"));
+            }
+            eprintln!("{header}");
+        });
+        static NEXT_ID: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(1);
+        let (scenario, phase, iteration) = PROFILE_CONTEXT.with(std::cell::Cell::get);
+        Some(Self {
+            navigation: NEXT_ID.fetch_add(1, Ordering::Relaxed),
+            content,
+            shape,
+            action,
+            path,
+            scenario,
+            phase,
+            iteration,
+            rows: Vec::with_capacity(32),
+        })
+    }
+
+    fn report(self) {
+        let path = self.path.replace('"', "\"\"");
+        for row in self.rows {
+            let mut output = format!(
+                "router_profile,{},{},{},{},{},{:?},{:?},\"{}\",{},{}",
+                self.navigation,
+                self.scenario,
+                self.phase,
+                self.iteration,
+                self.content,
+                self.shape,
+                self.action,
+                path,
+                row.update,
+                row.elapsed.as_nanos(),
+            );
+            for counter in row.scopes {
+                output.push_str(&format!(
+                    ",{},{}",
+                    counter.calls,
+                    counter.elapsed.as_nanos()
+                ));
+            }
+            eprintln!("{output}");
+        }
+    }
 }

