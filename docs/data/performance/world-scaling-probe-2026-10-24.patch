+//! Temporary synchronous scope probes for the non-MT benchmark build only.
+//! Top-level system stages are distinct calls; descendant scopes overlap them.
+//! All rows are diagnostic inclusive wall times, not optimized timing evidence.
+use std::{
+    cell::RefCell,
+    sync::OnceLock,
+    time::{Duration, Instant},
+};
+macro_rules! define_scopes {
+    ($($variant:ident => $name:literal),+ $(,)?) => {
+        pub const SCOPE_NAMES: &[&str] = &[$($name),+];
+        #[derive(Clone, Copy)]
+        #[repr(usize)]
+        pub(crate) enum Scope { $($variant),+ }
+    };
+}
+define_scopes! {
+    ObserveAuthority => "observe_authority",
+    CollectNavigation => "collect_navigation",
+    DriveNavigation => "drive_navigation",
+    CommitPresentation => "commit_presentation",
+    SettleCleanup => "settle_cleanup",
+    PublishSnapshots => "publish_snapshots",
+    InputRefresh => "input_refresh",
+    InputFilter => "input_filter",
+    ScrollPrepare => "scroll_prepare",
+    ScrollSettle => "scroll_settle",
+    CreateNativeScene => "create_native_scene",
+    ValidateAdoption => "validate_adoption",
+    ValidateAdoptionRelationships => "validate_adoption_relationships",
+    AdoptionParentChildrenLoop => "adoption_parent_children_loop",
+    BsnPrepare => "bsn_prepare",
+    BsnResolve => "bsn_resolve",
+    TargetsAreCurrent => "targets_are_current",
+    RelatedProtectedIsCurrent => "related_protected_is_current",
+    CurrentFocusTargets => "current_focus_targets",
+    SettlePreparedRemoval => "settle_prepared_removal",
+    PrepareInputGateMutation => "prepare_input_gate_mutation",
+    TryPreparePointerRevocations => "try_prepare_pointer_revocations",
+    RemovedReceiptIndex => "removed_receipt_index",
+    ProtectedFields => "protected_fields",
+    PreparePresentationAccess => "prepare_presentation_access",
+    PrepareRemovalPlan => "prepare_removal_plan",
+    PrepareReceiptBatch => "prepare_receipt_batch",
+}
+#[derive(Clone, Copy, Debug, Default)]
+pub struct Counter {
+    pub calls: u64,
+    pub elapsed: Duration,
+}
+thread_local! {
+    static COUNTERS: RefCell<[Counter; SCOPE_NAMES.len()]> = const {
+        RefCell::new([Counter { calls: 0, elapsed: Duration::ZERO }; SCOPE_NAMES.len()])
+    };
+}
+pub fn enabled() -> bool {
+    static ENABLED: OnceLock<bool> = OnceLock::new();
+    *ENABLED.get_or_init(|| std::env::var("ROUTER_BENCH_PROFILE_SCOPES").as_deref() == Ok("1"))
+}
+/// Use only outside App::update with no live scope guards, on its executing thread.
+pub fn reset() {
+    COUNTERS.with(|c| *c.borrow_mut() = [Counter::default(); SCOPE_NAMES.len()]);
+}
+/// Non-MT App::update executes the measured systems on this same thread.
+pub fn take() -> [Counter; SCOPE_NAMES.len()] {
+    COUNTERS.with(|c| std::mem::take(&mut *c.borrow_mut()))
+}
+pub(crate) struct ScopeTimer {
+    scope: Scope,
+    start: Option<Instant>,
+}
+pub(crate) fn enter(scope: Scope) -> ScopeTimer {
+    ScopeTimer {
+        scope,
+        start: enabled().then(Instant::now),
+    }
+}
+impl Drop for ScopeTimer {
+    fn drop(&mut self) {
+        if let Some(start) = self.start {
+            let elapsed = start.elapsed();
+            COUNTERS.with(|c| {
+                let counter = &mut c.borrow_mut()[self.scope as usize];
+                counter.calls += 1;
+                counter.elapsed += elapsed;
+            });
+        }
+    }
+}
