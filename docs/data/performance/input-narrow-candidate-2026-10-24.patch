+    #[test]
+    fn gate_delta_rejects_duplicates_and_preserves_revocation_order_on_reauthorization() {
+        let mut world = World::new();
+        let first = world.spawn_empty().id();
+        let second = world.spawn_empty().id();
+        let preserved = world.spawn_empty().id();
+        let still_revoked = world.spawn_empty().id();
+        let entering = world.spawn_empty().id();
+        world.insert_resource(RouterInputGate::new());
+        prepare_input_gate_mutation(
+            world.resource_mut::<RouterInputGate>(),
+            &[],
+            vec![first, second, preserved, still_revoked],
+        )
+        .unwrap()
+        .apply();
+        prepare_input_gate_mutation(
+            world.resource_mut::<RouterInputGate>(),
+            &[still_revoked, first],
+            vec![],
+        )
+        .unwrap()
+        .apply();
+        assert_eq!(
+            world.resource::<RouterInputGate>().revoked,
+            vec![first, still_revoked]
+        );
+        let tick = world
+            .get_resource_change_ticks::<RouterInputGate>()
+            .unwrap()
+            .changed;
+        world.increment_change_tick();
+
+        for (remove, add) in [
+            (vec![entering], vec![]),
+            (vec![second, second], vec![]),
+            (vec![], vec![entering, entering]),
+            (vec![], vec![second]),
+        ] {
+            assert!(
+                prepare_input_gate_mutation(world.resource_mut::<RouterInputGate>(), &remove, add)
+                    .is_none()
+            );
+        }
+        let gate = world.resource::<RouterInputGate>();
+        assert_eq!(gate.allowed, vec![second, preserved]);
+        assert_eq!(gate.revoked, vec![first, still_revoked]);
+        assert_eq!(
+            world
+                .get_resource_change_ticks::<RouterInputGate>()
+                .unwrap()
+                .changed,
+            tick
+        );
+
+        prepare_input_gate_mutation(
+            world.resource_mut::<RouterInputGate>(),
+            &[second],
+            vec![first, entering],
+        )
+        .unwrap()
+        .apply();
+        let gate = world.resource::<RouterInputGate>();
+        assert_eq!(gate.allowed, vec![preserved, first, entering]);
+        assert_eq!(gate.revoked, vec![still_revoked, second]);
+    }
