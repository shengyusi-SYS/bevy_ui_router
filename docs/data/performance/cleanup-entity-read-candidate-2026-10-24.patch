+impl CleanupProtectedEntity {
+    // Resolve this exact Entity once for one read-only comparison. Each caller
+    // repeats the comparison after writes; no observation survives a mutation.
+    fn matches_current(
+        &self,
+        world: &World,
+        registry: &RouteEntityRegistry,
+        removed: &HashSet<Entity>,
+    ) -> bool {
+        let expected = &self.observed;
+        let entity = expected.entity;
+        let current = world.get_entity(entity).ok();
+        if matches!(self.scope, CleanupProtectedScope::AuthoritySource) {
+            return current.is_some() == expected.present
+                && current
+                    .as_ref()
+                    .and_then(|entity| entity.get::<RouterHostRegistration>())
+                    .map(|registration| (registration.router(), registration.incarnation()))
+                    == expected.host_registration;
+        }
+        current.is_some() == expected.present
+            && current
+                .as_ref()
+                .and_then(|entity| entity.get::<ChildOf>())
+                .map(ChildOf::parent)
+                == expected.parent
+            && current
+                .as_ref()
+                .and_then(|entity| entity.get::<Children>())
+                .into_iter()
+                .flat_map(|children| children.iter().copied())
+                .eq(expected
+                    .children
+                    .iter()
+                    .filter(|entity| !removed.contains(entity))
+                    .copied())
+            && registry.record(entity).map(|record| record.claim()) == expected.registry_claim
+            && current
+                .as_ref()
+                .and_then(|entity| entity.get::<RouteOwnershipSeal>())
+                .copied()
+                == expected.ownership_seal
+            && current
+                .as_ref()
+                .and_then(|entity| entity.get::<Visibility>())
+                .copied()
+                == expected.visibility
+            && current
+                .as_ref()
+                .and_then(|entity| entity.get::<Pickable>())
+                .map(|pickable| (pickable.should_block_lower, pickable.is_hoverable))
+                == expected.pickable
+            && current
+                .as_ref()
+                .and_then(|entity| entity.get::<RouterInputBarrier>())
+                .copied()
+                == expected.barrier
+            && current
+                .as_ref()
+                .and_then(|entity| entity.get::<FrameLifecycle>())
+                .copied()
+                == expected.frame_lifecycle
+            && current
+                .as_ref()
+                .and_then(|entity| entity.get::<ChildSlotLifecycle>())
+                .copied()
+                == expected.child_slot_lifecycle
+            && current
+                .as_ref()
+                .and_then(|entity| entity.get::<ChildSlotAuthority>())
+                == expected.child_slot_authority.as_ref()
+            && current
+                .as_ref()
+                .and_then(|entity| entity.get::<ProvisionalSlotLifecycle>())
+                .copied()
+                == expected.provisional_slot_lifecycle
+            && current
+                .as_ref()
+                .and_then(|entity| entity.get::<RouterHostRegistration>())
+                .map(|registration| (registration.router(), registration.incarnation()))
+                == expected.host_registration
+            && current
+                .as_ref()
+                .and_then(|entity| entity.get::<bevy_ui::Node>())
+                .map(|node| node.display)
+                == self.display
+    }
+}
