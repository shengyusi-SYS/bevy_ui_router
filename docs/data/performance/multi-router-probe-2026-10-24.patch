+//! Temporary two-Router observation diagnostic, not a production benchmark mode.
+use super::*;
+use bevy_ui::ScrollPosition;
+use bevy_ui_router_ecs::{NavigationRequestSnapshot, temporary_multi_router_profile as profile};
+
+#[derive(Component, Clone, Default)]
+struct BackgroundLayout;
+#[derive(Component, Clone, Default)]
+struct BackgroundPage;
+#[derive(Component, Clone, Default)]
+struct BackgroundContent;
+
+struct Background {
+    router: RouterHandle,
+    host: Entity,
+    layout: Entity,
+    page: Entity,
+    content: Vec<Entity>,
+    snapshot: RouterSnapshot,
+    requests: Vec<(NavigationRequestId, NavigationRequestSnapshot, usize)>,
+    history_storage: usize,
+}
+
+fn install_background(app: &mut App) -> Background {
+    let layout = app
+        .register_bsn_view(ViewDriverKey::new("multi-b-layout").unwrap(), |_| {
+            Ok(bsn! { Node BackgroundLayout Children [(Node DefaultOutlet)] })
+        })
+        .unwrap();
+    let page = app
+        .register_bsn_view(ViewDriverKey::new("multi-b-page").unwrap(), |_| {
+            Ok(SceneFunction(|_, root: &mut ResolvedScene| {
+                root.push_template(Node::default());
+                root.push_template(BackgroundPage);
+                for _ in 0..128 {
+                    let mut child = ResolvedScene::default();
+                    child.push_template(Node::default());
+                    child.push_template(BackgroundContent);
+                    root.get_or_insert_related_resolved_scenes::<ChildOf>()
+                        .scenes
+                        .push(child);
+                }
+            }))
+        })
+        .unwrap();
+    let layout_key = RouteViewKey::new("multi-b-layout").unwrap();
+    let page_key = RouteViewKey::new("multi-b-page").unwrap();
+    let mut views = RouteViewRegistry::new();
+    views
+        .insert(layout_key.clone(), RouteViewDescriptor::new(layout))
+        .unwrap();
+    views
+        .insert(page_key.clone(), RouteViewDescriptor::new(page))
+        .unwrap();
+    let mut routes = RouteTree::builder()
+        .root_with_options(
+            RoutePattern::path("/").unwrap(),
+            RouteNodeOptions::new().with_view(layout_key),
+        )
+        .unwrap();
+    routes
+        .route_with_options(
+            routes.root_id().unwrap(),
+            RoutePattern::path("background").unwrap(),
+            RouteNodeOptions::new().with_view(page_key.clone()),
+        )
+        .unwrap();
+    let router = app
+        .add_ui_router(RouterConfig::new(routes.build().unwrap(), views, page_key))
+        .unwrap();
+    let host = app
+        .world_mut()
+        .spawn((Node::default(), RouterHostRegistration::new(router)))
+        .id();
+    app.update();
+    let mut issued = Vec::with_capacity(64);
+    for _ in 0..64 {
+        let request = app
+            .world_mut()
+            .resource_mut::<RouterNavigation>()
+            .replace(router, RouteLocation::new("/background"))
+            .unwrap();
+        let mut complete = false;
+        for _ in 0..32 {
+            app.update();
+            let snapshots = app.world().resource::<RouterSnapshots>();
+            let RequestLookup::Found(result) = snapshots.request(router, request) else {
+                continue;
+            };
+            assert!(!matches!(result.status(), RequestStatus::Failed(_)));
+            let snapshot = snapshots.get(router).unwrap();
+            if result.status() == &RequestStatus::Succeeded
+                && snapshot.running_request().is_none()
+                && !snapshot.cleanup().foreground_pending()
+            {
+                assert_eq!(snapshot.cleanup().quarantine_count(), 0);
+                complete = true;
+                break;
+            }
+        }
+        assert!(
+            complete,
+            "B navigation reaches its public completion boundary"
+        );
+        issued.push(request);
+    }
+    let layout = only::<BackgroundLayout>(app);
+    let page = only::<BackgroundPage>(app);
+    let content = app
+        .world_mut()
+        .query_filtered::<Entity, With<BackgroundContent>>()
+        .iter(app.world())
+        .collect::<Vec<_>>();
+    let snapshots = app.world().resource::<RouterSnapshots>();
+    let snapshot = snapshots.get(router).unwrap().clone();
+    let history_storage = snapshots.get(router).unwrap().history().entries().as_ptr() as usize;
+    let requests = issued
+        .into_iter()
+        .map(|request| {
+            let RequestLookup::Found(value) = snapshots.request(router, request) else {
+                panic!("all 64 B terminal requests are retained");
+            };
+            (request, value.clone(), value.trace().as_ptr() as usize)
+        })
+        .collect();
+    Background {
+        router,
+        host,
+        layout,
+        page,
+        content,
+        snapshot,
+        requests,
+        history_storage,
+    }
+}
+
+impl Background {
+    // Boundary-only guard: do not warm B's content and records before every sample.
+    fn assert_unchanged(&self, app: &mut App) {
+        assert_eq!(only::<BackgroundLayout>(app), self.layout);
+        assert_eq!(only::<BackgroundPage>(app), self.page);
+        assert_eq!(self.content.len(), 128);
+        assert_eq!(
+            app.world_mut()
+                .query_filtered::<Entity, With<BackgroundContent>>()
+                .iter(app.world())
+                .count(),
+            128
+        );
+        let world = app.world();
+        assert!(world.get::<RouterHostRegistration>(self.host).is_some());
+        let gate = world.resource::<RouterInputGate>();
+        for entity in [self.layout, self.page]
+            .into_iter()
+            .chain(self.content.iter().copied())
+        {
+            assert_eq!(world.get::<Node>(entity), Some(&Node::default()));
+            assert!(world.get::<RouteScroll>(entity).is_none());
+            assert!(gate.allows_keyboard(entity));
+        }
+        for entity in &self.content {
+            assert!(world.get::<BackgroundContent>(*entity).is_some());
+            assert_eq!(world.get::<ChildOf>(*entity).unwrap().parent(), self.page);
+        }
+        let snapshots = world.resource::<RouterSnapshots>();
+        let current = snapshots.get(self.router).unwrap();
+        assert_eq!(current, &self.snapshot);
+        assert_eq!(current.history().entries().len(), 1);
+        assert_eq!(current.history().cursor(), Some(0));
+        assert_eq!(current.active().frames().len(), 2);
+        assert_eq!(
+            current.history().entries().as_ptr() as usize,
+            self.history_storage
+        );
+        assert_eq!(self.requests.len(), 64);
+        for (id, expected, trace_storage) in &self.requests {
+            let RequestLookup::Found(current) = snapshots.request(self.router, *id) else {
+                panic!("B request retention must remain unchanged");
+            };
+            assert_eq!(current, expected);
+            assert_eq!(current.status(), &RequestStatus::Succeeded);
+            assert_eq!(current.trace().as_ptr() as usize, *trace_storage);
+        }
+    }
+}
+
+fn update(app: &mut App) {
+    let started = profile::begin_update();
+    app.update();
+    profile::end_update(started);
+}
+
+pub(super) fn run(samples: usize) {
+    let mut fixture = Fixture::configured(128, ContentShape::Flat, Some(2));
+    let background = install_background(&mut fixture.app);
+    for index in 0..64 {
+        fixture.navigate(
+            Action::Replace,
+            if index % 2 == 0 {
+                "/items/b"
+            } else {
+                "/items/a"
+            },
+            false,
+        );
+    }
+    let layout = only::<Layout>(&mut fixture.app);
+    let toolbar = only::<Toolbar>(&mut fixture.app);
+    let baseline = fixture.census("a", 1);
+    let pages = baseline
+        .pages
+        .iter()
+        .map(|(entity, _)| {
+            (
+                fixture.app.world().get::<Page>(*entity).unwrap().0.clone(),
+                *entity,
+            )
+        })
+        .collect::<Vec<_>>();
+    let factory_calls = fixture.factory_count();
+    background.assert_unchanged(&mut fixture.app);
+    assert_eq!(
+        fixture
+            .app
+            .world_mut()
+            .query::<&RouteScroll>()
+            .iter(fixture.app.world())
+            .count(),
+        0
+    );
+    profile::bind(fixture.router, background.router);
+    eprintln!(
+        "# temporary two-Router diagnostic: A={:?}, B={:?}; same-thread headless build only; each has two native frames and 128 content nodes per page; B has 64 terminal requests and one history entry",
+        fixture.router, background.router
+    );
+    eprintln!(
+        "# inclusive scope times overlap outer update/navigation time; outer values repeat on A/B rows, so do not sum them; no layout/window/scroll-restoration timing"
+    );
+    println!(
+        "phase,sample,router,updates,update_total_ns,completion_ns,scroll_observe_calls,scroll_observe_ns,request_index_calls,request_index_ns,router_snapshot_rebuilds,request_snapshot_rebuilds"
+    );
+    for phase in ["idle_no_marker", "idle_a_marker", "a_hit_b_idle"] {
+        if phase == "idle_a_marker" {
+            fixture
+                .app
+                .world_mut()
+                .entity_mut(layout)
+                .insert((RouteScroll::new("body"), ScrollPosition::default()));
+        }
+        // Same warmup as the existing idle helper; all setup is outside samples.
+        for _ in 0..64 {
+            fixture.app.update();
+        }
+        let mut rows = Vec::with_capacity(samples);
+        let mut current = "a";
+        for sample in 0..samples {
+            profile::start();
+            let elapsed = if phase == "a_hit_b_idle" {
+                current = if sample % 2 == 0 { "b" } else { "a" };
+                let sample = fixture.navigate(Action::Replace, &format!("/items/{current}"), false);
+                let counters = profile::finish();
+                assert_eq!(counters.updates, sample.updates as u64);
+                rows.push((sample.elapsed, counters));
+                let census = fixture.census(current, 1);
+                assert_eq!(
+                    census.active_page(),
+                    pages.iter().find(|(id, _)| id == current).unwrap().1
+                );
+                assert_eq!(census.live, baseline.live);
+                assert_eq!(fixture.factory_count(), factory_calls);
+                assert_eq!(only::<Layout>(&mut fixture.app), layout);
+                assert_eq!(only::<Toolbar>(&mut fixture.app), toolbar);
+                assert_eq!(fixture.app.world().get::<Toolbar>(toolbar).unwrap().0, 73);
+                continue;
+            } else {
+                let started = Instant::now();
+                update(&mut fixture.app);
+                started.elapsed()
+            };
+            let counters = profile::finish();
+            assert_eq!(counters.updates, 1);
+            rows.push((elapsed, counters));
+        }
+        let after = fixture.census(current, 1);
+        assert_eq!(after.live, baseline.live);
+        assert_eq!(fixture.factory_count(), factory_calls);
+        background.assert_unchanged(&mut fixture.app);
+        for (sample, (elapsed, counters)) in rows.iter().enumerate() {
+            // Detect an unsupported execution-thread setup instead of reporting
+            // silently missing scope data from a worker-local counter.
+            if phase != "idle_no_marker" {
+                assert_eq!(counters.routers[0].scroll_observe_calls, counters.updates);
+            }
+            if phase == "a_hit_b_idle" {
+                assert!(counters.routers[0].request_index_calls > 0);
+            }
+            assert_eq!(counters.routers[1].router_snapshot_rebuilds, 0);
+            assert_eq!(counters.routers[1].request_snapshot_rebuilds, 0);
+            for (router, row) in ["A", "B"].into_iter().zip(counters.routers) {
+                println!(
+                    "{phase},{sample},{router},{},{},{},{},{},{},{},{},{}",
+                    counters.updates,
+                    counters.update_elapsed.as_nanos(),
+                    elapsed.as_nanos(),
+                    row.scroll_observe_calls,
+                    row.scroll_observe_elapsed.as_nanos(),
+                    row.request_index_calls,
+                    row.request_index_elapsed.as_nanos(),
+                    row.router_snapshot_rebuilds,
+                    row.request_snapshot_rebuilds
+                );
+            }
+        }
+    }
+    fixture.release_parent_scope();
+    background.assert_unchanged(&mut fixture.app);
+}
