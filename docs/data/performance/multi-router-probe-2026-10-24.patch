+//! Temporary same-thread diagnostics for one fixed pair of Routers.
+//! This module exists only in the isolated benchmark copy. No counter allocates.
+use crate::RouterHandle;
+use std::{
+    cell::RefCell,
+    time::{Duration, Instant},
+};
+
+#[derive(Clone, Copy, Default)]
+pub struct RouterCounters {
+    pub scroll_observe_calls: u64,
+    pub scroll_observe_elapsed: Duration,
+    pub request_index_calls: u64,
+    pub request_index_elapsed: Duration,
+    pub router_snapshot_rebuilds: u64,
+    pub request_snapshot_rebuilds: u64,
+}
+
+#[derive(Clone, Copy, Default)]
+pub struct SampleCounters {
+    pub routers: [RouterCounters; 2],
+    pub updates: u64,
+    pub update_elapsed: Duration,
+}
+
+#[derive(Default)]
+struct State {
+    handles: Option<[RouterHandle; 2]>,
+    enabled: bool,
+    sample: SampleCounters,
+}
+thread_local! {
+    static STATE: RefCell<State> = RefCell::new(State::default());
+}
+
+pub fn bind(a: RouterHandle, b: RouterHandle) {
+    assert_ne!(a, b);
+    STATE.with(|state| state.borrow_mut().handles = Some([a, b]));
+}
+pub fn start() {
+    STATE.with(|state| {
+        let mut state = state.borrow_mut();
+        assert!(state.handles.is_some() && !state.enabled);
+        state.sample = SampleCounters::default();
+        state.enabled = true;
+    });
+}
+pub fn finish() -> SampleCounters {
+    STATE.with(|state| {
+        let mut state = state.borrow_mut();
+        assert!(state.enabled);
+        state.enabled = false;
+        std::mem::take(&mut state.sample)
+    })
+}
+pub fn begin_update() -> Option<Instant> {
+    STATE.with(|state| state.borrow().enabled.then(Instant::now))
+}
+pub fn end_update(started: Option<Instant>) {
+    if let Some(started) = started {
+        let elapsed = started.elapsed();
+        STATE.with(|state| {
+            let mut state = state.borrow_mut();
+            state.sample.updates += 1;
+            state.sample.update_elapsed += elapsed;
+        });
+    }
+}
+fn index(handle: RouterHandle) -> Option<usize> {
+    STATE.with(|state| {
+        let state = state.borrow();
+        state
+            .enabled
+            .then(|| state.handles.unwrap().iter().position(|h| *h == handle))
+            .flatten()
+    })
+}
+#[derive(Clone, Copy)]
+pub(crate) enum Scope {
+    ScrollObserve,
+    RequestIndex,
+}
+pub(crate) struct ScopeTimer {
+    index: Option<usize>,
+    scope: Scope,
+    started: Option<Instant>,
+}
+pub(crate) fn enter(handle: RouterHandle, scope: Scope) -> ScopeTimer {
+    let index = index(handle);
+    ScopeTimer {
+        index,
+        scope,
+        started: index.map(|_| Instant::now()),
+    }
+}
+impl Drop for ScopeTimer {
+    fn drop(&mut self) {
+        if let (Some(index), Some(started)) = (self.index, self.started) {
+            let elapsed = started.elapsed();
+            STATE.with(|state| {
+                let mut state = state.borrow_mut();
+                let counter = &mut state.sample.routers[index];
+                match self.scope {
+                    Scope::ScrollObserve => {
+                        counter.scroll_observe_calls += 1;
+                        counter.scroll_observe_elapsed += elapsed;
+                    }
+                    Scope::RequestIndex => {
+                        counter.request_index_calls += 1;
+                        counter.request_index_elapsed += elapsed;
+                    }
+                }
+            });
+        }
+    }
+}
+pub(crate) fn router_snapshot_rebuilt(handle: RouterHandle) {
+    if let Some(index) = index(handle) {
+        STATE.with(|state| state.borrow_mut().sample.routers[index].router_snapshot_rebuilds += 1);
+    }
+}
+pub(crate) fn request_snapshot_rebuilt(handle: RouterHandle) {
+    if let Some(index) = index(handle) {
+        STATE.with(|state| state.borrow_mut().sample.routers[index].request_snapshot_rebuilds += 1);
+    }
+}
