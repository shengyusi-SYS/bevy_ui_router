+//! Temporary public-API diagnostic. Timings are distributions of batch means,
+//! not individual-match tail latency. Build the same fixture on both revisions.
+use std::{hint::black_box, time::Instant};
+
+use bevy_ui_router_core::prelude::{
+    MatchedRoute, RouteErrorKind, RouteErrorSourceCategory, RouteId, RouteLocation, RouteMatcher,
+    RoutePattern, RouteTree,
+};
+
+const SAMPLES: usize = 128;
+const WARMUP_BATCHES: usize = 16;
+const ITERATIONS_PER_SAMPLE: usize = 128;
+const QUERY: &str = "tab=details&tab=meta&encoded=%2F";
+
+struct Fixture {
+    matcher: RouteMatcher,
+    matched: RouteLocation,
+    not_found: RouteLocation,
+    expected_routes: [RouteId; 3],
+}
+
+impl Fixture {
+    fn new(siblings: usize) -> Self {
+        let mut builder = RouteTree::builder()
+            .root(RoutePattern::path("/").unwrap())
+            .unwrap();
+        let root = builder.root_id().unwrap();
+        let section = builder
+            .route(root, RoutePattern::path(":section").unwrap())
+            .unwrap();
+        let mut leaf = None;
+        for index in 0..siblings {
+            leaf = Some(
+                builder
+                    .route(
+                        section,
+                        RoutePattern::path(format!("page-{index:03}")).unwrap(),
+                    )
+                    .unwrap(),
+            );
+        }
+        let fixture = Self {
+            matcher: RouteMatcher::new(builder.build().unwrap()),
+            matched: RouteLocation::new(format!("/alpha/page-{:03}", siblings - 1))
+                .with_search(QUERY)
+                .with_fragment("body"),
+            not_found: RouteLocation::new("/alpha/missing")
+                .with_search(QUERY)
+                .with_fragment("body"),
+            expected_routes: [root, section, leaf.unwrap()],
+        };
+        fixture.validate();
+        fixture
+    }
+
+    fn validate(&self) {
+        let branch = self.matcher.match_location(&self.matched).unwrap();
+        assert_eq!(
+            branch
+                .routes()
+                .iter()
+                .map(MatchedRoute::route)
+                .collect::<Vec<_>>(),
+            self.expected_routes,
+        );
+        assert!(branch.routes()[0].params().is_empty());
+        assert_eq!(
+            branch.routes()[1].params().iter().collect::<Vec<_>>(),
+            vec![("section", "alpha")],
+        );
+        assert!(branch.routes()[2].params().is_empty());
+        assert_eq!(branch.leaf().unwrap().route(), self.expected_routes[2]);
+        assert_eq!(self.matched.search(), Some(QUERY));
+        assert_eq!(self.matched.fragment(), Some("body"));
+        let other_query = self
+            .matcher
+            .match_location(
+                &self
+                    .matched
+                    .clone()
+                    .with_search("tab=meta&tab=details&encoded=%2F"),
+            )
+            .unwrap();
+        assert_ne!(
+            branch.search_fingerprint(),
+            other_query.search_fingerprint()
+        );
+        assert_eq!(
+            branch
+                .routes()
+                .iter()
+                .map(MatchedRoute::route)
+                .collect::<Vec<_>>(),
+            other_query
+                .routes()
+                .iter()
+                .map(MatchedRoute::route)
+                .collect::<Vec<_>>(),
+        );
+        let other_fragment = self
+            .matcher
+            .match_location(&self.matched.clone().with_fragment("other"))
+            .unwrap();
+        assert_eq!(
+            branch.branch_fingerprint(),
+            other_fragment.branch_fingerprint()
+        );
+        let error = self.matcher.match_location(&self.not_found).unwrap_err();
+        assert_eq!(error.kind(), RouteErrorKind::NotFound);
+        assert_eq!(
+            error.source_category(),
+            RouteErrorSourceCategory::RouterCore
+        );
+        assert_eq!(self.not_found.search(), Some(QUERY));
+        assert_eq!(self.not_found.fragment(), Some("body"));
+    }
+}
+
+fn run_batch(matcher: &RouteMatcher, location: &RouteLocation) {
+    for _ in 0..ITERATIONS_PER_SAMPLE {
+        drop(black_box(
+            black_box(matcher).match_location(black_box(location)),
+        ));
+    }
+}
+
+fn measure(fixture: &Fixture, siblings: usize, scenario: &str, location: &RouteLocation) {
+    for _ in 0..WARMUP_BATCHES {
+        run_batch(&fixture.matcher, location);
+    }
+    let mut samples = Vec::with_capacity(SAMPLES);
+    for _ in 0..SAMPLES {
+        let start = Instant::now();
+        run_batch(&fixture.matcher, location);
+        let elapsed = start.elapsed();
+        samples.push(elapsed.as_secs_f64() * 1_000_000.0 / ITERATIONS_PER_SAMPLE as f64);
+    }
+    fixture.validate();
+    let mean = samples.iter().sum::<f64>() / SAMPLES as f64;
+    samples.sort_by(f64::total_cmp);
+    let percentile = |percent: usize| samples[(SAMPLES * percent).div_ceil(100) - 1];
+    println!(
+        "{scenario},{siblings},{},3,{SAMPLES},{ITERATIONS_PER_SAMPLE},{mean:.6},{:.6},{:.6},{:.6},{:.6}",
+        siblings + 2,
+        percentile(50),
+        percentile(95),
+        samples[SAMPLES - 1],
+        samples[0],
+    );
+}
+
+fn main() {
+    eprintln!(
+        "matcher_baseline: 3-level branches; {WARMUP_BATCHES} warmup batches; {SAMPLES} samples x {ITERATIONS_PER_SAMPLE} matches; result drop included; setup/validation/output excluded; percentiles are batch means"
+    );
+    println!(
+        "scenario,sibling_routes,total_routes,branch_depth,samples,iterations_per_sample,mean_us,p50_us,p95_us,max_us,min_us"
+    );
+    for siblings in [16, 64, 256] {
+        let fixture = Fixture::new(siblings);
+        measure(&fixture, siblings, "matched", &fixture.matched);
+        measure(&fixture, siblings, "not_found", &fixture.not_found);
+    }
+}
